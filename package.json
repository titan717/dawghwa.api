{
  "name": "dawghwa-api",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_TESTS=1 vitest run src/tests/live",
    "manifest": "node scripts/generate-source-manifest.mjs",
    "health:report": "tsx scripts/update-readme-health.ts",
    "bench": "node scripts/benchmark.mjs",
    "docs:sources": "tsx scripts/generate-source-docs.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/ui": "^1.0.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.28",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^1.0.4"
  },
  "description": "Dawghwa API - manga source metadata API (fork of GooglyBlox/comick-source-api)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/titan717/dawghwa.api.git"
  },
  "engines": {
    "node": ">=20"
  }
}
