# Dawghwa API configuration. Every variable is optional; defaults are shown.
# Copy to .env.local for local development. Never commit real credentials.

# --- General ---
# DAWGHWA_VERSION=1.1.0
# Expose raw internal error reasons in API responses (local debugging only).
# EXPOSE_ERROR_DETAILS=false

# --- Outbound requests to sources ---
# UPSTREAM_USER_AGENT=<browser-like UA>
# UPSTREAM_TIMEOUT_MS=10000           # per attempt
# UPSTREAM_RETRIES=2                  # retries for 408/425/429/5xx/network errors only
# UPSTREAM_RETRY_BASE_MS=300          # exponential backoff base (full jitter)
# UPSTREAM_RETRY_MAX_MS=4000          # backoff cap; Retry-After above this is not waited for
# UPSTREAM_MAX_RESPONSE_BYTES=8388608
# CONDITIONAL_CACHE_ENTRIES=500       # ETag / Last-Modified revalidation cache
# CONDITIONAL_CACHE_MAX_BYTES=67108864

# --- Source isolation ---
# SOURCE_OPERATION_TIMEOUT_MS=25000
# SOURCE_DEFAULT_RPS=5
# SOURCE_DEFAULT_BURST=10
# SOURCE_DEFAULT_MAX_CONCURRENT=6
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_COOLDOWN_MS=60000
# DISABLED_SOURCES=comix,bato         # ids to turn off on this server
# SOURCE_PRIORITY=mangadex,weebcentral # ids searched/matched first
# Experimental sources are left out entirely (sources, search, availability,
# catalog, frontpage, health) unless listed here. Empty by default. Local
# testing only; enabling one for users needs a human decision. Currently
# experimental: comix (blocked, see docs/providers/comix-study.md).
# EXPERIMENTAL_PROVIDERS=

# --- Multi-source search / health ---
# SEARCH_CONCURRENCY=16
# SEARCH_SOURCE_TIMEOUT_MS=12000
# SEARCH_OVERALL_TIMEOUT_MS=25000
# HEALTH_CONCURRENCY=12
# HEALTH_SOURCE_TIMEOUT_MS=15000
# HEALTH_OVERALL_TIMEOUT_MS=55000

# --- Cache ---
# CACHE_ENABLED=true
# CACHE_MEMORY_MAX_ENTRIES=2000
# CACHE_MEMORY_MAX_BYTES=67108864
# Optional shared Redis cache over the Upstash-compatible REST protocol:
# REDIS_REST_URL=https://<your-instance>.upstash.io
# REDIS_REST_TOKEN=<token>
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted)
# REDIS_PREFIX=dawghwa:
# TTL / stale-while-revalidate windows in seconds:
# CACHE_SEARCH_TTL=300
# CACHE_SEARCH_SWR=1800
# CACHE_CHAPTERS_TTL=600
# CACHE_CHAPTERS_SWR=3600
# CACHE_METADATA_TTL=3600
# CACHE_METADATA_SWR=86400
# CACHE_FRONTPAGE_TTL=300
# CACHE_FRONTPAGE_SWR=1800
# CACHE_HEALTH_TTL=300
# CACHE_HEALTH_SWR=1800
# CACHE_PAGES_TTL=300
# CACHE_CATALOG_TTL=900
# CACHE_CATALOG_SWR=3600

# --- Metadata / catalogue (AniList, MangaDex, MangaUpdates) ---
# METADATA_PROVIDERS=anilist,mangadex,mangaupdates
# METADATA_DEFAULT_PROVIDER=anilist
# METADATA_TIMEOUT_MS=10000
# AniList documents 90 req/min but currently enforces 30; stay under it.
# ANILIST_REQUESTS_PER_MINUTE=30

# --- Source availability ("which sources carry this title") ---
# AVAILABILITY_MIN_SCORE=0.82         # title similarity needed for a "high" match
# AVAILABILITY_MAX_ALT_QUERIES=1      # extra title queries for sources with no match

# --- Public API protection ---
# API_MAX_BODY_BYTES=16384
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_EXPENSIVE_PER_MINUTE=12  # multi-source search, full health checks
# Trust X-Forwarded-For / X-Real-IP. Only enable behind a proxy that overwrites them.
# TRUST_PROXY=true
# CORS_ORIGINS=*                      # comma-separated list of allowed origins
